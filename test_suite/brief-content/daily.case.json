{
  "contractVersion": "cortex.case-definition.v1",
  "description": "daily 简报合成样例（非真实用户数据）",
  "threshold": 1,
  "vars": {
    "task": "生成 daily brief",
    "request_body": {
      "bundle": {
        "version": 1,
        "brief_type": "daily",
        "context": {
          "uid": 7,
          "current_time": "2026-09-23T00:00:00Z",
          "timezone": "Asia/Shanghai",
          "lang": "zh-Hans",
          "recent_conversation_messages": []
        },
        "material": {
          "snapshot": {
            "owner_user_id": "7",
            "as_of": "2026-09-23T00:00:00Z",
            "memories": [
              {
                "semantic_memory_ref": "memory-1",
                "domain": "USER",
                "subject_id": "7",
                "memory_kind": "user.commitment",
                "content": "今天下班前确认 Atlas 试点的 20 个核心案例和脱敏权限。"
              },
              {
                "semantic_memory_ref": "memory-2",
                "domain": "USER",
                "subject_id": "7",
                "memory_kind": "preference",
                "content": "偏好深色界面。"
              }
            ],
            "projects": [],
            "person_ids": [],
            "persons": []
          },
          "preparation_capabilities": [
            "SEARCH_MAIL"
          ]
        }
      },
      "timeout_seconds": 120
    }
  },
  "metadata": {
    "case_id": "brief-daily-001",
    "req_id": "eval-daily-001",
    "task_id": "brief-replay",
    "business_module": "brief_daily",
    "scenario_tag": "synthetic_positive"
  },
  "semanticEvaluation": {
    "contractVersion": "cortex.semantic-evaluation-contract.v1",
    "goal": "基于冻结材料生成 daily 简报",
    "successCriteria": [
      "覆盖核心事项，不把背景噪音当成重点，不捏造事实"
    ],
    "enabledDimensions": [
      "response"
    ],
    "scorePassThreshold": 0.85,
    "brief": {
      "briefType": "daily",
      "checklist": [
        {
          "id": "core_cases",
          "tier": "P0",
          "assertion": "提醒需确认20个核心案例，而非声称已经确认完成",
          "sourceRefs": [
            "/material/snapshot/memories/0/content"
          ]
        },
        {
          "id": "privacy",
          "tier": "P0",
          "assertion": "提醒确认脱敏权限",
          "sourceRefs": [
            "/material/snapshot/memories/0/content"
          ]
        },
        {
          "id": "evergreen",
          "tier": "P2",
          "assertion": "将偏好深色界面作为今日重点事项",
          "sourceRefs": [
            "/material/snapshot/memories/1/content"
          ]
        }
      ],
      "constraints": {
        "allowedGenerationStatuses": [
          "generated"
        ]
      }
    }
  },
  "assert": [
    {
      "type": "javascript",
      "metric": "Brief replay 成功",
      "weight": 1,
      "value": "const body = typeof output === \"string\" ? JSON.parse(output) : output; return body.ok === true && body.task_name === \"EVAL_BRIEF_REPLAY\";"
    }
  ]
}
